# Single env file — used by BOTH docker-compose and the app server.
# (server/src/config points dotenv here; compose reads repo-root .env natively.)

# --- app ---
PORT=3000
JWT_SECRET=change-this-to-a-long-random-string

# --- database ---
# DB_PORT is the HOST port for PostgreSQL. Your server already runs its own
# PostgreSQL on 5432, so pick something free here. Inside compose the app
# always talks to the internal db:5432, so this never clashes.
DB_PORT=5434
DB_NAME=tekser
DB_USER=tekser
DB_PASSWORD=tekser
# Only used when running the app on the host (outside compose):
DB_HOST=localhost

# --- container backend ---
# mock   = no Docker daemon needed (UI / session flow / grading-webhook testing)
# docker = real per-student sandbox containers. Needs the sandbox image built
#          (cd docker && docker build -t tekser-sandbox:latest -f Dockerfile.sandbox .)
CONTAINER_DRIVER=mock
SANDBOX_IMAGE=tekser-sandbox:latest
CONTAINER_MEMORY_MB=128
CONTAINER_CPUS=0.5
CONTAINER_PIDS_LIMIT=64
CMD_LOG_CALLBACK_URL=http://host.docker.internal:3000/api/cmd-log

DEFAULT_SESSION_DURATION_MINUTES=10
