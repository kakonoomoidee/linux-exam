# Single env file — used by BOTH docker-compose and the app server.
# (server/src/config points dotenv here; compose reads repo-root .env natively.)

# --- app ---
PORT=3000
JWT_SECRET=change-this-to-a-long-random-string

# --- database ---
# DB_PORT is the HOST port for PostgreSQL. Your server already runs its own
# PostgreSQL on 5432, so pick something free here. Inside compose the app
# always talks to the internal db:5432, so this never clashes.
DB_PORT=5434
DB_NAME=tekser
DB_USER=tekser
DB_PASSWORD=tekser
# Only used when running the app on the host (outside compose):
DB_HOST=localhost

# --- container backend ---
# mock   = no Docker daemon needed (UI / session flow / grading-webhook testing)
# docker = real per-student sandbox containers. Needs the sandbox image built
#          (docker compose builds it automatically via the sandbox-image
#          service — see docker-compose.yml)
CONTAINER_DRIVER=mock
SANDBOX_IMAGE=tekser-sandbox:latest
# Internal-only Docker network sandbox containers join (see docker-compose.yml
# `networks:`). No route to the internet, but containers on it can still
# reach the `app` service by name — that's what CMD_LOG_CALLBACK_URL below
# relies on. Only relevant when CONTAINER_DRIVER=docker via compose.
SANDBOX_NETWORK=tekser-sandbox-net
CONTAINER_MEMORY_MB=128
CONTAINER_CPUS=0.5
CONTAINER_PIDS_LIMIT=64
# Sandbox containers reach the app by its compose service name over
# tekser-sandbox-net — no host.docker.internal needed.
CMD_LOG_CALLBACK_URL=http://app:3000/api/cmd-log

DEFAULT_SESSION_DURATION_MINUTES=10
