{
  "name": "tekser-exam-server",
  "version": "1.0.0",
  "description": "Real-sandbox Linux practical exam platform (per-student Docker containers, story-based questions, live auto-grading + manual review)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/scripts/seedSample.js",
    "import-questions": "node src/scripts/importQuestions.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dockerode": "^4.0.2",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "socket.io": "^4.7.5",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "allowScripts": {
    "cpu-features@0.0.10": true,
    "protobufjs@7.6.6": true,
    "ssh2@1.17.0": true
  }
}
