<%
  /* Shared forgot-password screen: NIM -> Telegram OTP -> new password.
     Included by both views/student/index.ejs and views/admin/index.ejs; driven by
     /shared/forgot-password.js. Element IDs and `student.forgotPw*` i18n keys are
     shared across both pages on purpose (they resolve on /admin too). */
%>
<div id="forgot-password-screen" class="screen hidden min-h-screen flex items-center justify-center p-6">
  <div class="card w-full max-w-sm text-center">
    <div class="brand-mark mx-auto mb-4">&gt;_</div>
    <h1 class="text-lg font-bold mb-1" data-i18n="student.forgotPwTitle">Lupa Password</h1>
    <p id="forgot-pw-step-indicator" class="text-xs uppercase tracking-[0.15em] text-[color:var(--text-faint)] mb-4"></p>

    <div id="forgot-pw-step1">
      <p class="text-sm text-[color:var(--text-faint)] mb-6" data-i18n="student.forgotPwStep1Sub">
        Masukkan NIM kamu. Kalau Telegram sudah terhubung, kode OTP akan dikirim ke sana.
      </p>
      <label class="label text-left" for="forgot-nim-input" data-i18n="common.nim">NIM</label>
      <input id="forgot-nim-input" class="field mb-4" autocomplete="off" inputmode="numeric" />
      <button id="forgot-pw-send-btn" class="btn btn-primary btn-block" data-i18n="student.forgotPwSendBtn">Kirim OTP</button>
    </div>

    <div id="forgot-pw-step2" class="hidden">
      <p id="forgot-pw-generic-msg" class="text-sm text-[color:var(--text-muted)] mb-5" aria-live="polite"></p>
      <label class="label text-left" for="forgot-otp-input" data-i18n="student.otpLabel">Kode OTP</label>
      <input id="forgot-otp-input" class="field mb-2 text-center tracking-[0.3em] font-mono"
        inputmode="numeric" autocomplete="one-time-code" maxlength="6" />
      <p id="forgot-otp-error" class="text-[color:var(--danger)] text-sm mb-3 min-h-[18px]"></p>
      <label class="label text-left" for="forgot-new-pw-input" data-i18n="student.newPw">Password baru</label>
      <input id="forgot-new-pw-input" type="password" class="field mb-3" autocomplete="off" />
      <label class="label text-left" for="forgot-confirm-pw-input" data-i18n="student.confirmPw">Ulangi password baru</label>
      <input id="forgot-confirm-pw-input" type="password" class="field mb-4" autocomplete="off" />
      <button id="forgot-pw-reset-btn" class="btn btn-primary btn-block" data-i18n="student.forgotPwResetBtn">Simpan Password Baru</button>
    </div>

    <button id="forgot-pw-back-btn" class="btn btn-ghost btn-sm btn-block mt-2" data-i18n="student.backToLogin">Kembali ke Login</button>
  </div>
</div>
