<section id="tab-grades" class="tab-content hidden max-w-5xl mx-auto p-6">
  <div class="card">
    <div class="card-title" data-i18n="admin.gradesHeading">Mahasiswa &amp; Nilai</div>
    <div class="flex flex-wrap gap-2 items-center mb-4">
      <select id="grades-session-select" class="field w-auto min-w-[220px]"></select>
      <button id="grades-load-btn" class="btn btn-primary btn-sm" data-i18n="admin.showBtn">Tampilkan</button>
      <button id="grades-transcript-btn" class="btn btn-ghost btn-sm" data-i18n="admin.sessionTranscript">Transkrip Sesi</button>
      <a id="grades-export-csv-link" href="#" download
        class="text-[color:var(--accent-hover)] hover:underline text-sm ml-auto"
        data-i18n="admin.exportCsv">Export CSV Nilai</a>
    </div>
    <div id="grades-table" class="overflow-x-auto"></div>
    <div id="grades-transcript" class="hidden mt-6 border-t border-[color:var(--border)] pt-4"></div>
  </div>
</section>
