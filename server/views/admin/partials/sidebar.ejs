<%
  // Shared admin sidebar.
  //   standalone=false (dashboard): items are tab buttons the SPA wires up.
  //   standalone=true  (standalone page, e.g. /admin/sessions/:id): items are
  //                    plain links back into the dashboard at /admin#<tab>.
  const isStandalone = typeof standalone !== 'undefined' && standalone;
  const activeTab = typeof active !== 'undefined' && active ? active : 'sessions';
  const items = [
    { tab: 'sessions', i18n: 'admin.tabSessions', label: 'Sesi',
      icon: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>' },
    { tab: 'questions', i18n: 'admin.tabQuestions', label: 'Bank Soal', role: 'instruktur-visible',
      icon: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>' },
    { tab: 'review', i18n: 'admin.tabReview', label: 'Review Nilai',
      icon: '<path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>' },
    { tab: 'grades', i18n: 'admin.tabGrades', label: 'Mahasiswa & Nilai',
      icon: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>' },
    { tab: 'students', i18n: 'admin.tabStudents', label: 'Mahasiswa',
      icon: '<path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>' },
    { tab: 'staff', i18n: 'admin.tabStaff', label: 'Staf', role: 'instruktur-visible',
      icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 11l-3 3-1.5-1.5"/>' },
    { tab: 'audit', i18n: 'admin.tabAudit', label: 'Audit Log', role: 'instruktur-visible',
      icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/>' },
  ];
%>
<aside class="sidebar">
  <div class="sidebar-brand">
    <div class="brand-mark">&gt;_</div>
    <span data-i18n="admin.dashboardHeading">Tekser Exam Admin</span>
  </div>

  <% items.forEach((it) => { %>
    <%
      const isActive = it.tab === activeTab;
      const roleAttr = it.role ? ` data-role="${it.role}"` : '';
      const activeCls = isActive ? ' active' : '';
    %>
    <% if (isStandalone) { %>
      <a class="side-link<%= activeCls %>" href="/admin#<%= it.tab %>"<%- roleAttr %><%- isActive ? ' aria-current="page"' : '' %>>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%- it.icon %></svg>
        <span data-i18n="<%= it.i18n %>"><%= it.label %></span>
      </a>
    <% } else { %>
      <button class="side-link tab-btn<%= activeCls %>" data-tab="<%= it.tab %>"<%- roleAttr %>>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%- it.icon %></svg>
        <span data-i18n="<%= it.i18n %>"><%= it.label %></span>
      </button>
    <% } %>
  <% }) %>

  <% if (!isStandalone) { %>
    <%/* Staff bind their own Telegram here — prerequisite for OTP password reset.
         Driven by /shared/telegram-connect.js; same element IDs as the student sidebar. */%>
    <button id="telegram-connect-btn" class="side-link mt-auto">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/></svg>
      <span data-i18n="student.telegramHeading">Hubungkan Telegram</span>
      <span id="telegram-status" class="badge badge-gray ml-auto" data-i18n="student.telegramNotLinked">Belum terhubung</span>
    </button>
    <button id="telegram-disconnect-btn" class="side-link mt-auto hidden">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18.84 12.25l1.72-1.71a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M5.17 11.75l-1.72 1.71a5 5 0 0 0 7.07 7.07l1.71-1.71"/><line x1="8" y1="2" x2="8" y2="5"/><line x1="2" y1="8" x2="5" y2="8"/><line x1="16" y1="19" x2="16" y2="22"/><line x1="19" y1="16" x2="22" y2="16"/></svg>
      <span data-i18n="student.telegramDisconnectBtn">Putuskan</span>
    </button>
    <a id="telegram-bot-link" class="block text-[11px] text-[color:var(--text-faint)] px-2 mb-1 truncate hover:underline"
      target="_blank" rel="noopener" hidden></a>
  <% } %>

  <button id="admin-logout-btn" class="side-link<%= isStandalone ? ' mt-auto' : '' %>">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg>
    <span data-i18n="common.logout">Keluar</span>
  </button>
</aside>
