<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title data-i18n="admin.createSessionHeading">Buat Sesi Baru</title>
  <script>window.__I18N__ = <%- localesScript %>;</script>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/shared/theme.css" />
  <!-- Gate instruktur-only chrome before first paint (theme.css hides
       [data-role="instruktur-visible"] until <html> gets .is-instruktur) so the
       sidebar doesn't shift after render. Mirrors readRole() in api.js. -->
  <script>try{if(JSON.parse(atob((localStorage.getItem('tekser_admin_token')||'').split('.')[1]||'')).role==='instruktur')document.documentElement.classList.add('is-instruktur');}catch(e){}</script>
</head>
<body class="min-h-screen">

  <select id="lang-switcher" aria-label="Language">
    <option value="id">ID</option>
    <option value="en">EN</option>
  </select>

  <div class="app-shell">
    <%- include('partials/sidebar', { standalone: true, active: 'sessions' }) %>

    <main class="main-pane">
      <div class="pane-wrap">
        <a href="/admin" class="inline-block text-sm text-[color:var(--text-muted)] hover:text-[color:var(--text)]"
          data-i18n="admin.backToSessions">← Kembali ke daftar sesi</a>

        <header>
          <h1 class="page-title" id="page-title" data-i18n="admin.createSessionHeading">Buat Sesi Baru</h1>
        </header>

    <!-- create: editable form (create state only — an existing session's metadata
         has no edit endpoint and is shown read-only in #summary-card) -->
    <div class="card max-w-2xl" id="create-card">
      <div class="grid sm:grid-cols-[1fr_140px_120px] gap-3">
        <div>
          <label class="label" for="f-name" data-i18n="admin.sessionNameLabel">Nama sesi</label>
          <input id="f-name" class="field" data-i18n-ph="admin.sessionNamePlaceholder"
            placeholder="Nama sesi (mis. UTS Praktikum Batch 1)" />
        </div>
        <div>
          <label class="label" for="f-duration" data-i18n="admin.durationPlaceholder">Durasi (menit)</label>
          <input id="f-duration" type="number" min="1" class="field" value="10" />
        </div>
        <div>
          <label class="label" for="f-ucp" data-i18n="admin.sessionUcpLabel">UCP</label>
          <select id="f-ucp" class="field">
            <option value="1">UCP 1</option>
            <option value="2">UCP 2</option>
          </select>
        </div>
      </div>
      <button id="create-btn" class="btn btn-primary btn-sm mt-3" data-role="instruktur-visible"
        data-i18n="admin.createSessionBtn">Buat Sesi</button>
      <p id="create-error" class="text-[color:var(--danger)] text-sm mt-2 min-h-[20px]"></p>
    </div>

    <!-- manage: read-only summary -->
    <div class="card hidden" id="summary-card">
      <div class="card-title" id="summary-name"></div>
      <div class="flex flex-wrap gap-2 mt-2" id="summary-meta"></div>
    </div>

    <!-- manage: join code -->
    <div class="card hidden max-w-2xl mx-auto" id="joincode-card">
      <div class="rounded-lg border border-[color:var(--border)] bg-[color:var(--bg)] p-4 text-center">
        <div class="text-[10px] uppercase tracking-[0.15em] text-[color:var(--text-faint)] mb-1"
          data-i18n="admin.joinCodeLabel">Kode Join</div>
        <div id="join-code-value" class="text-3xl font-bold font-mono tracking-[0.3em]">------</div>
      </div>
    </div>

    <!-- manage: roster + start -->
    <div class="card hidden" id="roster-card">
      <label class="label" for="participant-nims" data-i18n="admin.addParticipants">Tambah Peserta</label>
      <textarea id="participant-nims" rows="4" class="field font-mono text-sm mb-3"
        data-i18n-ph="admin.nimsPlaceholder"
        placeholder="Satu per baris — NIM, atau &quot;NIM, Nama, Kelas&quot;"></textarea>
      <div class="flex flex-wrap gap-2">
        <button id="add-participants-btn" class="btn btn-ghost btn-sm"
          data-i18n="admin.addParticipants">Tambah Peserta</button>
        <button id="start-exam-btn" class="btn btn-success btn-sm"
          data-i18n="admin.startExam">▶ Mulai Ujian</button>
      </div>
      <div id="participant-list" class="mt-4"></div>
    </div>
      </div>
    </main>
  </div>

  <script src="/shared/i18n.js"></script>
  <script src="/shared/vendor/socket.io.min.js"></script>
  <script src="/shared/vendor/sweetalert2.all.min.js"></script>
  <script src="/shared/ui.js"></script>
  <script src="/admin-assets/js/api.js"></script>
  <script src="/admin-assets/js/session-form.js"></script>
</body>
</html>
