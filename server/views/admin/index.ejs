<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title data-i18n="admin.title">Admin - Tekser Exam</title>
  <script>window.__I18N__ = <%- localesScript %>;</script>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/shared/theme.css" />
</head>
<body class="min-h-screen">

  <select id="lang-switcher" aria-label="Language">
    <option value="id">ID</option>
    <option value="en">EN</option>
  </select>

  <!-- login -->
  <div id="login-screen" class="screen min-h-screen flex items-center justify-center p-6">
    <div class="card w-full max-w-sm text-center">
      <div class="brand-mark mx-auto mb-4">&gt;_</div>
      <h1 class="text-lg font-bold mb-1" data-i18n="admin.loginHeading">Admin Login</h1>
      <p class="text-sm text-[color:var(--text-faint)] mb-6" data-i18n="admin.loginSubtitle">
        Masuk untuk mengelola sesi ujian.
      </p>
      <label class="label text-left" for="admin-nim" data-i18n="common.nim">NIM</label>
      <input id="admin-nim" class="field mb-3" data-i18n-ph="admin.nimPlaceholder" placeholder="NIM Admin" />
      <label class="label text-left" for="admin-password" data-i18n="common.password">Password</label>
      <input id="admin-password" type="password" class="field mb-4"
        data-i18n-ph="common.password" placeholder="Password" />
      <button id="admin-login-btn" class="btn btn-primary btn-block" data-i18n="common.login">Masuk</button>
      <p id="admin-login-error" class="text-[color:var(--danger)] text-sm mt-3 min-h-[20px]"></p>
    </div>
  </div>

  <!-- dashboard -->
  <div id="dashboard-screen" class="screen hidden">
    <div class="app-shell">
      <aside class="sidebar">
        <div class="sidebar-brand">
          <div class="brand-mark">&gt;_</div>
          <span data-i18n="admin.dashboardHeading">Tekser Exam Admin</span>
        </div>

        <button class="side-link tab-btn active" data-tab="sessions">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          <span data-i18n="admin.tabSessions">Sesi</span>
        </button>
        <button class="side-link tab-btn" data-tab="questions" data-role="instruktur-visible">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          <span data-i18n="admin.tabQuestions">Bank Soal</span>
        </button>
        <button class="side-link tab-btn" data-tab="review">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          <span data-i18n="admin.tabReview">Review Nilai</span>
        </button>
        <button class="side-link tab-btn" data-tab="grades">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          <span data-i18n="admin.tabGrades">Mahasiswa &amp; Nilai</span>
        </button>
        <button class="side-link tab-btn" data-tab="students">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
          <span data-i18n="admin.tabStudents">Mahasiswa</span>
        </button>
        <button class="side-link tab-btn" data-tab="staff" data-role="instruktur-visible">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 11l-3 3-1.5-1.5"/></svg>
          <span data-i18n="admin.tabStaff">Staf</span>
        </button>

        <button id="admin-logout-btn" class="side-link mt-auto">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg>
          <span data-i18n="common.logout">Keluar</span>
        </button>
      </aside>

      <main class="main-pane">
        <%- include('partials/sessions-tab') %>
        <%- include('partials/questions-tab') %>
        <%- include('partials/review-tab') %>
        <%- include('partials/grades-tab') %>
        <%- include('partials/students-tab') %>
        <%- include('partials/staff-tab') %>
      </main>
    </div>
  </div>

  <script src="/shared/i18n.js"></script>
  <script src="/shared/vendor/socket.io.min.js"></script>
  <script src="/shared/vendor/sweetalert2.all.min.js"></script>
  <script src="/shared/ui.js"></script>
  <script src="/admin-assets/js/app.js"></script>
  <script src="/admin-assets/js/sessions.js"></script>
  <script src="/admin-assets/js/questions.js"></script>
  <script src="/admin-assets/js/review.js"></script>
  <script src="/admin-assets/js/grades.js"></script>
  <script src="/admin-assets/js/students.js"></script>
  <script src="/admin-assets/js/staff.js"></script>
  <script src="/admin-assets/js/socket.js"></script>
</body>
</html>
