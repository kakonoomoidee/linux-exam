<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title data-i18n="student.title">Ujian Praktikum Linux</title>
  <script>window.__I18N__ = <%- localesScript %>;</script>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/shared/vendor/xterm.min.css" />
  <link rel="stylesheet" href="/shared/theme.css" />
</head>
<body class="min-h-screen">

  <select id="lang-switcher" aria-label="Language">
    <option value="id">ID</option>
    <option value="en">EN</option>
  </select>

  <!-- login -->
  <div id="login-screen" class="screen min-h-screen flex items-center justify-center p-6">
    <div class="card w-full max-w-sm text-center">
      <div class="brand-mark mx-auto mb-4">&gt;_</div>
      <h1 class="text-lg font-bold" data-i18n="student.title">Ujian Praktikum Linux</h1>
      <p class="text-sm text-[color:var(--text-faint)] mt-1 mb-6" data-i18n="student.loginSubtitle">
        Masuk dengan NIM dan password.
      </p>
      <label class="label text-left" for="nim-input" data-i18n="common.nim">NIM</label>
      <input id="nim-input" class="field mb-3" data-i18n-ph="student.nimPlaceholder"
        placeholder="Masukkan NIM" autocomplete="off" inputmode="numeric" />
      <label class="label text-left" for="password-input" data-i18n="common.password">Password</label>
      <input id="password-input" type="password" class="field mb-4" data-i18n-ph="student.passwordPlaceholder"
        placeholder="Password (default: NIM)" autocomplete="off" />
      <button id="login-btn" class="btn btn-primary btn-block" data-i18n="common.login">Masuk</button>
      <p id="login-error" class="text-[color:var(--danger)] text-sm mt-3 min-h-[20px]"></p>
    </div>
  </div>

  <!-- forced password change on first login -->
  <div id="change-password-screen" class="screen hidden min-h-screen flex items-center justify-center p-6">
    <div class="card w-full max-w-sm text-center">
      <div class="brand-mark mx-auto mb-4">&gt;_</div>
      <h1 class="text-lg font-bold mb-1" data-i18n="student.changePwTitle">Ganti Password</h1>
      <p id="change-pw-subtitle" class="text-sm text-[color:var(--text-faint)] mb-6" data-i18n="student.changePwSubtitle">
        Password default harus diganti sebelum melanjutkan.
      </p>
      <label class="label text-left" for="current-pw-input" data-i18n="student.currentPw">Password saat ini</label>
      <input id="current-pw-input" type="password" class="field mb-3" autocomplete="off" />
      <label class="label text-left" for="new-pw-input" data-i18n="student.newPw">Password baru</label>
      <input id="new-pw-input" type="password" class="field mb-3" autocomplete="off" />
      <label class="label text-left" for="confirm-pw-input" data-i18n="student.confirmPw">Ulangi password baru</label>
      <input id="confirm-pw-input" type="password" class="field mb-4" autocomplete="off" />
      <button id="change-pw-btn" class="btn btn-primary btn-block" data-i18n="student.changePwBtn">Simpan</button>
      <button id="change-pw-back-btn" class="btn btn-ghost btn-sm btn-block mt-2 hidden"
        data-i18n="student.backToDashboard">Kembali ke Dashboard</button>
      <p id="change-pw-error" class="text-[color:var(--danger)] text-sm mt-3 min-h-[20px]"></p>
    </div>
  </div>

  <!-- dashboard: landing page after login. app-shell here ONLY — never on the exam screen. -->
  <div id="dashboard-screen" class="screen hidden">
    <div class="app-shell">
      <aside class="sidebar">
        <div class="sidebar-brand">
          <div class="brand-mark">&gt;_</div>
          <span data-i18n="student.title">Ujian Praktikum Linux</span>
        </div>

        <div class="flex items-center gap-3 min-w-0 shrink-0 max-w-[200px] px-2 pb-4 mb-1 border-b border-[color:var(--border)]">
          <span id="dash-avatar" class="avatar" aria-hidden="true"></span>
          <div class="min-w-0 leading-tight">
            <div id="dash-name" class="card-row__name truncate"></div>
            <div class="card-row__meta">
              <span id="dash-nim" class="mono truncate"></span><span id="dash-kelas"></span>
            </div>
          </div>
        </div>

        <button id="change-pw-link" class="side-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-3 3a5 5 0 1 0-7 7l-7 7v3h3l7-7a5 5 0 0 0 7-7l-2 2-3-3z"/><path d="M15 9l3 3"/></svg>
          <span data-i18n="student.changePwLink">Ganti Password</span>
        </button>

        <button id="logout-btn" class="side-link mt-auto">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg>
          <span data-i18n="common.logout">Keluar</span>
        </button>
      </aside>

      <main class="main-pane">
        <header class="mb-6">
          <h1 class="page-title" data-i18n="student.title">Ujian Praktikum Linux</h1>
          <p class="page-subtitle" data-i18n="student.dashSubtitle">Gabung ke sesi ujian dan lihat riwayat nilaimu.</p>
        </header>

        <div class="card">
          <div class="card-title" data-i18n="student.joinHeading">Join Ujian</div>
          <div class="flex gap-2">
            <input id="join-code-input" class="field font-mono tracking-[0.3em] text-center uppercase"
              maxlength="6" autocomplete="off" data-i18n-ph="student.joinPlaceholder" placeholder="Kode 6 huruf" />
            <button id="join-btn" class="btn btn-primary btn-sm shrink-0" data-i18n="student.joinBtn">Gabung</button>
          </div>
          <p id="join-error" class="text-[color:var(--danger)] text-sm mt-2 min-h-[20px]"></p>
        </div>

        <div class="card">
          <div class="card-title" data-i18n="student.historyHeading">Riwayat Nilai</div>
          <div id="history-list"></div>
        </div>
      </main>
    </div>
  </div>

  <!-- waiting for the session to start -->
  <div id="waiting-screen" class="screen hidden min-h-screen flex items-center justify-center p-6" aria-busy="true">
    <div class="card max-w-sm text-center flex flex-col items-center gap-4">
      <div id="waiting-spinner" class="flex flex-col items-center gap-4">
        <div class="spinner"></div>
        <p class="text-[color:var(--text-muted)]" data-i18n="student.waiting">
          Menunggu asisten dosen memulai sesi...
        </p>
      </div>
      <div id="waiting-error" class="hidden flex flex-col items-center gap-4">
        <p class="text-[color:var(--danger)]" data-i18n="student.provisionError">
          Gagal menyiapkan environment. Coba submit kode lagi atau hubungi asisten.
        </p>
        <button id="waiting-back-btn" class="btn btn-primary" data-i18n="student.backToDashboard">
          Kembali ke Dashboard
        </button>
      </div>
      <div id="waiting-pending" class="hidden flex flex-col items-center gap-4">
        <div class="spinner"></div>
        <p class="text-[color:var(--text-muted)]" data-i18n="student.waitingForStart">
          Menunggu instruktur memulai ujian...
        </p>
        <button id="waiting-pending-back-btn" class="btn btn-ghost btn-sm" data-i18n="student.backToDashboard">
          Kembali ke Dashboard
        </button>
      </div>
      <div id="waiting-ready" class="hidden flex flex-col items-center gap-4">
        <div class="text-3xl" aria-hidden="true">✅</div>
        <p class="text-[color:var(--text-muted)]" data-i18n="student.envReady">
          Environment kamu sudah siap.
        </p>
        <button id="start-exam-now-btn" class="btn btn-primary btn-block" data-i18n="student.startExamNow">
          Mulai Ujian
        </button>
        <p class="text-xs text-[color:var(--text-faint)]" data-i18n="student.timerRunsNote">
          Waktu ujian tetap berjalan sejak instruktur memulai — menunda hanya mengurangi waktumu.
        </p>
      </div>
    </div>
  </div>

  <!-- exam -->
  <div id="exam-screen" class="screen hidden h-screen flex flex-col">
    <header class="flex items-center justify-between gap-4 px-5 py-3 bg-[color:var(--surface)] border-b border-[color:var(--border)]">
      <div class="flex items-center gap-3 min-w-0">
        <span id="student-avatar" class="avatar avatar-sm" aria-hidden="true"></span>
        <div class="min-w-0 leading-tight">
          <div id="student-name" class="font-semibold truncate"></div>
          <div id="student-kelas" class="meta-faint truncate"></div>
        </div>
      </div>
      <div class="text-center leading-none">
        <div class="text-[10px] uppercase tracking-[0.15em] text-[color:var(--text-faint)] mb-1"
          data-i18n="student.timeLeft">Sisa waktu</div>
        <span id="timer" class="text-2xl font-bold">--:--</span>
      </div>
      <button id="submit-btn" class="btn btn-primary btn-sm" data-i18n="student.submitNow">Submit Sekarang</button>
    </header>

    <main class="flex flex-1 min-h-0 overflow-hidden">
      <aside class="w-80 shrink-0 flex flex-col bg-[color:var(--surface)] border-r border-[color:var(--border)]">
        <div class="px-4 py-3 text-xs font-semibold uppercase tracking-[0.12em] text-[color:var(--text-faint)] border-b border-[color:var(--border)]"
          data-i18n="student.questionsHeading">Soal</div>
        <div id="question-panel" class="flex-1 overflow-y-auto p-4 space-y-3"></div>
      </aside>
      <div class="flex-1 min-w-0 min-h-0 p-3 bg-[color:var(--bg)] flex">
        <div id="terminal" class="terminal-frame flex-1"></div>
      </div>
    </main>

    <div id="toast-container" class="fixed bottom-5 right-5 flex flex-col gap-2 z-10"
      role="status" aria-live="polite"></div>

    <!-- anti-cheat: covers terminal + questions the instant the student leaves the tab -->
    <div id="lock-overlay" class="hidden fixed inset-0 z-50 bg-[color:var(--bg)]/95 backdrop-blur-sm
      flex items-center justify-center p-6">
      <div class="card w-full max-w-md text-center">
        <div class="text-4xl mb-3">🔒</div>
        <h2 class="text-lg font-bold mb-2" data-i18n="student.lockedTitle">Ujian Dikunci</h2>
        <p class="text-sm text-[color:var(--text-muted)] mb-5" data-i18n="student.lockedBody">
          Ujian dikunci karena kamu meninggalkan tab. Minta kode dari asisten dosen.
        </p>
        <input id="lock-code-input" class="field text-center tracking-[0.3em] font-mono text-lg mb-3"
          inputmode="numeric" autocomplete="off" maxlength="6"
          data-i18n-ph="student.unlockCodePlaceholder" placeholder="Kode 6 digit" />
        <button id="lock-unlock-btn" class="btn btn-primary btn-block"
          data-i18n="student.unlockBtn">Buka Kunci</button>
        <p id="lock-error" class="text-[color:var(--danger)] text-sm mt-3 min-h-[20px]"></p>
      </div>
    </div>
  </div>

  <!-- exam results are shown as a modal (window.ui.modal) over whatever screen the
       student was on — see showResultsModal() in app.js. No dead-end screen. -->

  <script src="/shared/i18n.js"></script>
  <script src="/shared/vendor/xterm.min.js"></script>
  <script src="/shared/vendor/xterm-addon-fit.min.js"></script>
  <script src="/shared/vendor/socket.io.min.js"></script>
  <script src="/shared/vendor/sweetalert2.all.min.js"></script>
  <script src="/shared/ui.js"></script>
  <script src="/exam-assets/js/app.js"></script>
</body>
</html>
